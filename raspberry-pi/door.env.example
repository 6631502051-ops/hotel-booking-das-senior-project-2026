# Copy to door.env (same folder as door_lock.py) and fill in the values.

# Rooms handled by this Pi, comma separated.
DAS_ROOMS=101,102,103,104,105,106

# Primary production path: HTTPS API through the Cloudflare tunnel.
DAS_API_URL=https://your-tunnel.trycloudflare.com/api/door-authenticate.php
DAS_DEVICE_KEY=same-as-DOOR_DEVICE_KEY-in-server-.env
DAS_DEVICE_ID=pi-door-1
DAS_API_TIMEOUT=5

# Optional MQTT experiment only. Ignored unless door_lock.py uses --mqtt.
DAS_MQTT_URL=wss://your-tunnel.trycloudflare.com/mqtt
DAS_MQTT_USER=das_door
DAS_MQTT_PASSWORD=same-as-MQTT_DOOR_PASSWORD-in-server-.env

DAS_UNLOCK_SECONDS=5
DAS_GPIO=auto
DAS_GREEN_PIN=17
DAS_RED_PIN=27
DAS_BUZZER_PIN=22
DAS_RELAY_PIN=

# Optional servo motors.
DAS_SERVO_PINS=18,13
DAS_SERVO_ROOMS=*,*
DAS_SERVO_REVERSE=0,1
DAS_SERVO_CLOSED_ANGLE=0
DAS_SERVO_OPEN_ANGLE=90
DAS_SERVO_MIN_PULSE_MS=0.5
DAS_SERVO_MAX_PULSE_MS=2.5
DAS_SERVO_MOVE_SECONDS=0.8
DAS_SERVO_HOLD=false
