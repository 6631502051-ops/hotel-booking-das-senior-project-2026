# systemd service: starts the door lock at boot and restarts it if it stops.
# Install:  sudo cp das-door.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now das-door
# Logs:     journalctl -u das-door -f
[Unit]
Description=DAS Digital Door Lock simulation
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/das-door
ExecStart=/home/pi/das-door/.venv/bin/python /home/pi/das-door/door_lock.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
