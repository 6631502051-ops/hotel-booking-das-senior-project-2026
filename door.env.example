# Copy to door.env (same folder as door_lock.py) and fill in the values.

# Rooms this Pi simulates, comma separated (one MQTT connection per room).
DAS_ROOMS=101,102,103,104,105,106

# MQTT broker. Two ways to reach it:
#  A) Through the website's Cloudflare tunnel (works from anywhere):
#     DAS_MQTT_URL=wss://<your-tunnel>.trycloudflare.com/mqtt
#  B) Same LAN as the server (needs MQTT_BIND=0.0.0.0 on the server):
#     DAS_MQTT_URL=mqtt://192.168.1.10:1883
DAS_MQTT_URL=wss://your-tunnel.trycloudflare.com/mqtt
DAS_MQTT_USER=das_door
DAS_MQTT_PASSWORD=same-as-MQTT_DOOR_PASSWORD-in-server-.env

# Server API that checks the code
#  A) https://<your-tunnel>.trycloudflare.com/api/door-authenticate.php
#  B) http://192.168.1.10:8080/api/door-authenticate.php  (needs WEB_BIND=0.0.0.0)
DAS_API_URL=https://your-tunnel.trycloudflare.com/api/door-authenticate.php
DAS_DEVICE_KEY=same-as-DOOR_DEVICE_KEY-in-server-.env
DAS_DEVICE_ID=pi-door-1

# How long the door stays unlocked
DAS_UNLOCK_SECONDS=5

# GPIO: auto = use it if present, off = screen only, on = must have GPIO
DAS_GPIO=auto
DAS_GREEN_PIN=17
DAS_RED_PIN=27
DAS_BUZZER_PIN=22
# Optional relay for a real electric lock (leave empty to skip)
DAS_RELAY_PIN=

# ---------------------------------------------------------------- Servo motors
# Servos turn DAS_SERVO_OPEN_ANGLE when a code is accepted, then go back after DAS_UNLOCK_SECONDS.
# Default: 2 servos on GPIO 18 and GPIO 13 (BCM numbers = physical pins 12 and 33).
# Leave DAS_SERVO_PINS empty to use no servos.
DAS_SERVO_PINS=18,13
# Which room each servo belongs to, in the same order as DAS_SERVO_PINS.
#   *,*      = both servos open for every room (e.g. one double door in the demo model)
#   101,102  = servo 1 opens room 101, servo 2 opens room 102
DAS_SERVO_ROOMS=*,*
# 1 = mounted mirrored, so it turns the other way (the 2nd leaf of a double door). Closed = 180°, open = 90°.
DAS_SERVO_REVERSE=0,1
# Angle when locked and when open (0-180). The difference is the turn: 0 -> 90 = 90 degrees.
DAS_SERVO_CLOSED_ANGLE=0
DAS_SERVO_OPEN_ANGLE=90
# Pulse width for 0° and 180°. SG90/MG90S: 0.5 / 2.5. If the servo turns less than 90°, or buzzes
# against its end stop, try 1.0 / 2.0 (standard servos) or adjust a little.
DAS_SERVO_MIN_PULSE_MS=0.5
DAS_SERVO_MAX_PULSE_MS=2.5
# Seconds a move takes; after that the signal is switched off to stop jitter.
DAS_SERVO_MOVE_SECONDS=0.8
# true = keep the signal on to hold the position by force (servo gets warm and may buzz)
DAS_SERVO_HOLD=false
