# Copy to .env and replace every placeholder before deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=digital_authentication_system_das
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-long-random-app-password
# Use the existing database volume from project-tester-v1.
MYSQL_VOLUME_NAME=project-tester-v1_mysql_data

# Optional OTP delivery integration.
OTP_WEBHOOK_URL=https://your-trusted-service.example/otp
OTP_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
OTP_DEBUG=false

# Digital door lock (Senior Project 2).
# Key the Raspberry Pi sends in X-Device-Key when it asks the server to check a code.
DOOR_DEVICE_KEY=replace-with-a-long-random-device-key
# MQTT passwords: das_keypad = keypad page, das_door = Raspberry Pi.
MQTT_KEYPAD_PASSWORD=replace-with-a-random-keypad-password
MQTT_DOOR_PASSWORD=replace-with-a-random-door-password
# 127.0.0.1 keeps a port on this computer only; 0.0.0.0 opens it to the LAN (for the Pi without the tunnel).
WEB_BIND=127.0.0.1
MQTT_BIND=127.0.0.1
